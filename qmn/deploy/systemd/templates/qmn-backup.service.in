# qmn-backup.service — nightly encrypted off-host backup (TN-13 / DEC-0198).
# Holds CT-14 payload key + object-storage credentials for ONE run only.
# Never receives venue session material (DEC-0227).

[Unit]
Description=QMX nightly backup (qmn)
Documentation=file:///opt/qmx/current/docs/lenses/ops/runbook.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=qmx
Group=qmx
WorkingDirectory=/opt/qmx/current
ExecStart=/opt/qmx/current/.venv/bin/python -m qmn.data.backup_run
Nice=10

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/var/lib/qmx
LogsDirectory=qmn
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Host-key sealed (--with-key=host). Backup unit credentials only.
LoadCredentialEncrypted=backup-payload-key
LoadCredentialEncrypted=object-storage

Environment=TZ=UTC
Environment=QMX_ROOT=/opt/qmx/current
Environment=QMX_STATE=/var/lib/qmx
