# cloned reference repositories (large, recreatable from workroom/reference/links.md)
workroom/reference/repos/

# python
__pycache__/
*.pyc
.venv/
*.whl

# build artifacts (uv build / poe build-all)
dist/
build/
*.tar.gz
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.json

# data downloads never belong in git (root-anchored so it never swallows the
# qmf-data package source at packages/qmf-data/src/qmf/data/)
/data/
*.bi5

# recorded raw evidence (append-only local archive, never committed)
recorder/data/

# agent tooling installs — reinstallable, not project content
.agent/
.agents/
.claude/
_bmad/*
!_bmad/config.toml
!_bmad/config.user.toml
!_bmad/custom/

# OS noise
Thumbs.db
.DS_Store

# sssf runtime
adws/adw_data/sessions/
adws/adw_data/sssf.db*
.env

# Skylos local project state: the reference-graph index and the PyPI-existence
# cache it rebuilds on demand. Local only, never shared (docs.skylos.dev/cli-reference).
.skylos/
