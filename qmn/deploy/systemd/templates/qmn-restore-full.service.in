# qmn-restore-full.service — monthly full restore into scratch (DEC-0198).
# Integrity test only; host-loss rehearsal is the restore_drill_run power,
# not a timer (DEC-0252).

[Unit]
Description=QMX monthly full restore drill (qmn)
Documentation=file:///opt/qmx/current/docs/lenses/ops/runbook.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=qmx
Group=qmx
WorkingDirectory=/opt/qmx/current
ExecStart=/opt/qmx/current/.venv/bin/python -m qmn.data.restore_full
Nice=10

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/var/lib/qmx
LogsDirectory=qmn
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

LoadCredentialEncrypted=backup-payload-key
LoadCredentialEncrypted=object-storage

Environment=TZ=UTC
Environment=QMX_ROOT=/opt/qmx/current
Environment=QMX_STATE=/var/lib/qmx
