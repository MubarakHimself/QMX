{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qmx.local/qma-wire/schemas/query.v1.schema.json",
  "title": "QMA wire query family (CT-40)",
  "description": "Query family payload. Reads durable state through HTTP GET. Snapshots are authoritative. Closed-and-addable under qma-wire.",
  "type": "object",
  "additionalProperties": false,
  "required": ["family", "name"],
  "properties": {
    "family": { "const": "query" },
    "name": {
      "type": "string",
      "enum": [
        "get_quant",
        "list_missions",
        "get_graph_state",
        "inspect_ledger",
        "inspect_trace",
        "list_installed_plugins",
        "get_provider_health"
      ]
    },
    "args": { "type": "object" }
  }
}
